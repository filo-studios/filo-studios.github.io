: &#x22;integer&#x22;,\n    required: true,\n  },\n  wheelBone: {\n    description: 'Bone name (&#x22;wheel_lf&#x22;, &#x22;wheel_rf&#x22;, &#x22;wheel_lr&#x22;, &#x22;wheel_rr&#x22;) or a numeric bone index. If a bone index is passed it will be resolved to the matching name automatically.',\n    type: &#x22;string | integer&#x22;,\n    required: true,\n  },\n  lugnutCount: {\n    description: &#x22;How many bolt entities to spawn around the wheel.&#x22;,\n    type: &#x22;integer&#x22;,\n    default: &#x22;5&#x22;,\n  },\n  isTightening: {\n    description: &#x22;Direction of rotation. true rotates clockwise (tighten) and locks the bolt on completion. false rotates counter-clockwise (loosen) and enables physics so the bolt falls away.&#x22;,\n    type: &#x22;boolean&#x22;,\n    default: &#x22;false&#x22;,\n  },\n  canCancel: {\n    description: &#x22;Whether the player can exit the minigame early by pressing Escape or Backspace.&#x22;,\n    type: &#x22;boolean&#x22;,\n    default: &#x22;true&#x22;,\n  },\n}\"\n/>"},"51":{"id":"/docs/free_resources/filo_bolt/export-9","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"Value"},"52":{"id":"/docs/free_resources/filo_bolt/export-10","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"Meaning"},"53":{"id":"/docs/free_resources/filo_bolt/export-11","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"`true`"},"54":{"id":"/docs/free_resources/filo_bolt/export-12","page_id":"/docs/free_resources/filo_bolt/export","tags":[],"type":"text","url":"/docs/free_resources/filo_bolt/export#return-value","content":"All bolts were successfully rotated"},"55":{"id":"/docs/free_resources/filo_bolt/export-13","page_id":"/docs/free_resources/filo_bolt/export","tags":[]